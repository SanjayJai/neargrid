# Public Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=NearGrid

# Server-Only Laravel 13 REST API Origin (Never expose internal secrets to browser)
API_BASE_URL=http://127.0.0.1:8000

# BFF Opaque Session Store (Redis required in production; in-memory fallback allowed only in local dev)
REDIS_URL=redis://127.0.0.1:6379/1

# 32+ byte secret used to AES-256-GCM encrypt Sanctum tokens inside the server-side session store
BFF_SESSION_SECRET=replace-with-at-least-32-random-characters-in-env

# Session TTL in seconds (default 30 days, aligned with SANCTUM_TOKEN_EXPIRATION_MINUTES)
BFF_SESSION_TTL_SECONDS=2592000
