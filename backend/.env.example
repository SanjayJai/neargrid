APP_NAME="LocalBiz Directory API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL 8.0 (English + Tamil utf8mb4_0900_ai_ci + Spatial SRID 4326)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=localbiz_directory
DB_USERNAME=localbiz
DB_PASSWORD=localbiz_secret
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci

# Redis 7 (Cache, Queues, Rate Limiting, Autocomplete)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

# Sanctum Stateless Bearer Tokens & CORS
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200
SANCTUM_TOKEN_PREFIX=lbd_
CORS_ALLOWED_ORIGINS=http://localhost:3000

# OTP & Security
APP_OTP_PEPPER=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45

# Configurable Privacy Retention (DPDP Act 2023 / GDPR)
PRIVACY_CONSENT_VERSION=v1.0
PRIVACY_OTP_RETENTION_HOURS=24
PRIVACY_ENQUIRY_PII_RETENTION_DAYS=90
PRIVACY_CONTACT_LOG_RETENTION_DAYS=180
PRIVACY_SEARCH_LOG_RETENTION_DAYS=90
PRIVACY_KYC_RETENTION_YEARS=5
PRIVACY_TAX_RECORD_RETENTION_YEARS=8
PRIVACY_AUDIT_LOG_RETENTION_YEARS=5

# Object Storage (Public Media Bucket + Private Encrypted KYC Bucket)
FILESYSTEM_DISK=local
MEDIA_PUBLIC_DISK=media_public
MEDIA_KYC_DISK=kyc_private
MEDIA_PUBLIC_DRIVER=local
MEDIA_KYC_DRIVER=local
MEDIA_PRESERVE_ORIGINALS=false
MEDIA_ASYNC_THRESHOLD_BYTES=524288
MEDIA_QUEUE_NAME=media
MEDIA_KYC_SIGNED_URL_TTL_SECONDS=60
AWS_ACCESS_KEY_ID=localbiz_minio
AWS_SECRET_ACCESS_KEY=localbiz_minio_secret
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=localbiz-public-media
AWS_PRIVATE_KYC_BUCKET=localbiz-private-kyc
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Mail (Mailpit locally)
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@localbiz.local"
MAIL_FROM_NAME="${APP_NAME}"

# Search Engine (MySQL 8 Native Stage 1 / Meilisearch Stage 2 seam)
SEARCH_ENGINE_DRIVER=mysql
SEARCH_DEFAULT_PER_PAGE=20
SEARCH_MAX_PER_PAGE=40
SEARCH_MAX_PAGE=250
SEARCH_DEFAULT_RADIUS_KM=10
SEARCH_MAX_RADIUS_KM=50
SEARCH_SPONSORED_MAX_SLOTS=2
SEARCH_SUGGESTIONS_MIN_LENGTH=2
SEARCH_SUGGESTIONS_CACHE_TTL=120
SEARCH_RATE_LIMIT=120
SEARCH_SUGGESTIONS_RATE_LIMIT=120
SEARCH_SLOW_QUERY_MS=250
SEARCH_LOG_QUERIES=true

# Payments & Webhooks (Razorpay primary / Stripe optional)
PAYMENT_DEFAULT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
