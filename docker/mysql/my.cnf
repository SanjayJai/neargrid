[mysqld]
# Character set & collation for English + Tamil Unicode support
character-set-server=utf8mb4
collation-server=utf8mb4_0900_ai_ci

# Strict SQL mode
sql_mode=STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# Index short tokens (e.g., AC, TV, RO, EV, short Tamil stems)
innodb_ft_min_token_size=2

# Slow query telemetry matching SLOs
slow_query_log=1
long_query_time=0.5

# Binary logging for PITR & backup readiness
log_bin=mysql-bin
binlog_format=ROW
binlog_expire_logs_seconds=604800
